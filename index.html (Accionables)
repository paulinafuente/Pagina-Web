  /* ---------- Formulario Brevo real, reskin a tema oscuro ---------- */

  .sib-form-wrap{max-width:440px;margin:0 auto;}

  #sib-form-container.sib-form-container{
    background:var(--bg-elevated) !important;
    border:1px solid rgba(37,211,102,0.32) !important;
    border-radius:18px !important;
    box-shadow:0 0 32px -6px rgba(37,211,102,0.22);
    padding:30px 26px !important;
    max-width:100% !important;
  }
  .sib-form-message-panel{display:none;}
  /* Honeypot antispam de Brevo. Tiene que ser display:none, NO el patrón
     "visually hidden" de accesibilidad: con clip/opacity el campo sigue
     renderizado y enfocable, y el autorrelleno del navegador o un gestor de
     contraseñas lo llena (se llama email_address_check, type=text). Si llega
     con valor, el servidor de Brevo marca el envío como bot y responde
     success:false. sib-styles.css ya usa display:none !important; lo
     replicamos aquí para no depender del orden de carga de las hojas. */
  .input--hidden{display:none !important;}

  .sib-form-message-panel.sib-msg-err,
  .sib-form-message-panel.sib-msg-ok{
    font-size:13px !important;
    text-align:center !important;
    border-radius:10px !important;
    padding:12px 14px !important;
    margin-bottom:14px !important;
  }
  .sib-form-message-panel.sib-msg-err{background:rgba(255,138,128,0.12) !important;color:#ff8a80 !important;}
  .sib-form-message-panel.sib-msg-ok{background:rgba(37,211,102,0.12) !important;color:var(--accent) !important;}

  #sib-container.sib-container--large{
    background:transparent !important;
    border:none !important;
    max-width:100% !important;
    padding:0 !important;
  }
  .sib-input.sib-form-block{padding:0 0 14px 0 !important;}
  .sib-form-block input.input{
    width:100% !important;
    background:var(--bg) !important;
    border:1px solid var(--border) !important;
    border-radius:10px !important;
    padding:14px 16px !important;
    color:var(--text) !important;
    font-size:16px !important;
    min-height:48px !important;
    font-family:inherit !important;
  }
  .sib-form-block input.input:focus{border-color:var(--accent) !important;}
  .sib-form-block input.input::placeholder{color:var(--text-faint) !important;}
  .entry__error{font-size:12px !important;color:#ff8a80 !important;background:transparent !important;border:none !important;padding:4px 2px 0 !important;}

  .sib-form-block__button.btn-primary{
    width:100%;
    border:none;
  }

  /* El SVG del loader no tenía tamaño propio y se renderizaba a su viewBox
     completo (512x512) en vez de como icono pequeño. Lo fijamos explícitamente
