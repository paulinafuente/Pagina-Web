<script>
(function(){
  // Enlace literal de WhatsApp/ManyChat — NO modificar el texto, es el trigger nativo del flujo.
  const WHATSAPP_LINK = "https://wa.me/34684643594?text=Hola%20Paulina!%20Quiero%20los%20Accionables";
  const ENDPOINT_BREVO = "sibforms.com/serve/";

  // Pon DEBUG en false (o borra este bloque y sus usos) cuando el flujo funcione.
  const DEBUG = false;
  function mostrarDiagnostico(texto){
    console.log('[accionables][debug]\n' + texto);
    let caja = document.getElementById('debug-accionables');
    if (!caja) {
      caja = document.createElement('pre');
      caja.id = 'debug-accionables';
      caja.style.cssText = 'white-space:pre-wrap;word-break:break-all;text-align:left;font-size:11px;line-height:1.45;color:#9ad;background:#000;border:1px solid #345;border-radius:10px;padding:12px;margin:14px auto 0;max-width:440px;';
      document.querySelector('.sib-form-wrap').appendChild(caja);
    }
    caja.textContent = texto;
  }

  // Si la petición ni siquiera llega a 'load' (bloqueo de red/CORS), lo vemos.
  function diagnosticarFallo(xhr, urlDestino){
    if (!DEBUG) return;
    mostrarDiagnostico('EVENTO error/abort/timeout — el navegador no pudo leer la respuesta.\nURL:    ' + urlDestino + '\nstatus: ' + xhr.status + '\norigen: ' + window.location.origin);
  }

  let yaRedirigido = false;
  function redirigirWhatsApp(origen){
    if (yaRedirigido) return;
    yaRedirigido = true;
    console.log('[accionables] alta confirmada (' + origen + '). Redirigiendo a WhatsApp...');
    window.location.href = WHATSAPP_LINK; // misma pestaña
  }

  // ---- Fuente de verdad: la respuesta XHR de Brevo ----------------------
  // main.js de Brevo envía el formulario con UN XMLHttpRequest y decide en su
  // listener 'load' entre cuatro caminos distintos: e.redirect (navega solo),
  // e.successPage (reemplaza el innerHTML de #sib-container y hace return),
  // e.unsubReasonForm, o el mensaje inline. Solo el último añade la clase
  // 'sib-form-message-panel--active' a #success-message, así que vigilar ese
  // panel deja fuera tres de los cuatro casos y el usuario nunca llega a
  // WhatsApp. Leemos directamente el JSON de la respuesta, que es válido en
  // todos ellos.
  //
  // Este bloque se ejecuta durante el parseo del documento y main.js lleva
  // 'defer', por lo que el parche está puesto antes de que Brevo construya
  // su XHR. Envolvemos el constructor (no .send) para que nuestro listener
  // quede registrado ANTES que el de Brevo y por tanto se ejecute primero.
  const XHROriginal = window.XMLHttpRequest;
  window.XMLHttpRequest = function(){
    const xhr = new XHROriginal();
    const openOriginal = xhr.open;
    let urlDestino = '';

    xhr.open = function(metodo, url){
      urlDestino = String(url || '');
      return openOriginal.apply(xhr, arguments);
    };

    xhr.addEventListener('load', function(evento){
      if (urlDestino.indexOf(ENDPOINT_BREVO) === -1) return;

      // --- DIAGNÓSTICO TEMPORAL: quitar cuando el flujo esté confirmado ---
      if (DEBUG) {
        mostrarDiagnostico([
          'URL:    ' + urlDestino,
          'status: ' + xhr.status + ' ' + xhr.statusText,
          'tipo:   ' + (xhr.getResponseHeader('content-type') || '(sin content-type)'),
          'cuerpo: ' + JSON.stringify(xhr.responseText).slice(0, 400)
        ].join('\n'));
      }

      let respuesta;
      try {
        respuesta = JSON.parse(xhr.responseText);
      } catch (e) {
        console.warn('[accionables] respuesta de Brevo no parseable; no se redirige.', e);
        return; // que Brevo siga su curso y muestre su propio error
      }

      if (!respuesta || respuesta.success !== true) {
        console.warn('[accionables] Brevo rechazó el alta; no se redirige a WhatsApp.', respuesta && respuesta.message);
        return; // dejamos que Brevo pinte el mensaje de error y el usuario reintente
      }

      // Cortamos aquí el listener de Brevo: si el formulario tuviera
      // configurado un redirect o una successPage en el panel de Brevo,
      // nos robaría la navegación hacia WhatsApp.
      evento.stopImmediatePropagation();
      redirigirWhatsApp('respuesta XHR');
    });

    ['error','abort','timeout'].forEach(function(evt){
      xhr.addEventListener(evt, function(){
        if (urlDestino.indexOf(ENDPOINT_BREVO) === -1) return;
        diagnosticarFallo(xhr, urlDestino);
      });
    });

    return xhr;
  };
  window.XMLHttpRequest.prototype = XHROriginal.prototype;

  // ---- Respaldo: el panel de éxito inline ------------------------------
  // Solo cubre el cuarto caso, pero no cuesta nada mantenerlo por si Brevo
  // cambia de transporte en el futuro. 'yaRedirigido' evita el doble salto.
  const successEl = document.getElementById('success-message');
  if (successEl) {
    const successObserver = new MutationObserver(function(){
      if (window.getComputedStyle(successEl).display !== 'none') {
        successObserver.disconnect();
        redirigirWhatsApp('panel inline');
      }
    });
    successObserver.observe(successEl, {attributes:true, attributeFilter:['style','class']});
  }

  // Aparición progresiva al hacer scroll.
  const revealEls = document.querySelectorAll('.reveal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduceMotion || !('IntersectionObserver' in window)){
    revealEls.forEach(function(el){ el.classList.add('is-visible'); });
  } else {
    const io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.15, rootMargin:'0px 0px -60px 0px'});
    revealEls.forEach(function(el){ io.observe(el); });
  }
})();
</script>

